# 设备维修中台环境变量示例
DATABASE_URL=mysql+pymysql://device:Device.123@127.0.0.1:3306/device_service?charset=utf8mb4
APP_HOST=0.0.0.0
APP_PORT=18082

# shopkeeper_brain 手册 RAG（POST {RAG_BASE_URL}/query）
# 本地默认：E:\AAA message get\shopkeeper_brain → http://127.0.0.1:8001
# 服务不可用时回退本地 stub
RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=30

# 可选：Agent 调用鉴权（预留）
AGENT_API_KEY=
