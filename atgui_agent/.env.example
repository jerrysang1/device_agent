# 设备售后 Agent · 配置模板
# 复制为 .env 后填写；禁止把真实密钥提交到 Git 或写入文档。

# ---------- LLM（OpenAI 兼容协议，可对接通义千问等）----------
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# 兼容 langchain 默认变量名（可选，与上面二选一填）
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 设备维修中台 ----------
DEVICE_API_BASE_URL=http://127.0.0.1:18082
DEVICE_API_TIMEOUT_SECONDS=15

# ---------- 对话状态库（与 Compose 中 MYSQL_DATABASE 一致）----------
DATABASE_URL=mysql+aiomysql://device:REPLACE_ME@127.0.0.1:3306/device_service?charset=utf8mb4

# ---------- 手册 RAG（可选，不可用时降级 stub）----------
RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=30

# ---------- Agent 网关监听 ----------
APP_HOST=0.0.0.0
APP_PORT=8100
APP_DEBUG=false

# ---------- 中台服务间认证（可选）----------
# AGENT_API_KEY=REPLACE_ME

# ---------- Compose / MySQL（仅 docker compose 使用）----------
MYSQL_ROOT_PASSWORD=REPLACE_ME
MYSQL_DATABASE=device_service
MYSQL_USER=device
MYSQL_PASSWORD=REPLACE_ME
